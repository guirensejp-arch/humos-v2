# Copiar este archivo a .env y completar los valores.
# El .env NO se sube al repo (esta en .gitignore).

# Clave secreta de Flask (sesiones y CSRF). Generar una larga y aleatoria.
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Entorno: development | production
FLASK_ENV=development

# Base de datos. Si se omite, usa SQLite (instance/comanda.db).
# Ejemplo PostgreSQL:
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/comanda
